# EduManage Client Production & Development Environment Template
# Duplicate as .env in client root. DO NOT COMMIT PRODUCTION CREDENTIALS.

# -----------------------------------------------------------------------------
# Backend API Base URL
# -----------------------------------------------------------------------------
# In local development: http://localhost:5000/api/v1 (or leave blank for proxy /api/v1)
# In production: https://api.yourdomain.com/api/v1
VITE_API_URL=https://api.yourdomain.com/api/v1

# -----------------------------------------------------------------------------
# Application Branding & Metadata
# -----------------------------------------------------------------------------
VITE_APP_NAME="EduManage SMS"

# -----------------------------------------------------------------------------
# Role Mocking / Demo Switcher (MUST BE FALSE IN PRODUCTION)
# -----------------------------------------------------------------------------
VITE_ENABLE_MOCK_AUTH=false

# -----------------------------------------------------------------------------
# Real-Time WebSocket / Socket.IO Endpoint
# -----------------------------------------------------------------------------
# In local development: http://localhost:5000
# In production: https://api.yourdomain.com
VITE_SOCKET_URL=https://api.yourdomain.com
