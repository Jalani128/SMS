# =============================================================================
# EduManage Multi-Tenant School Management System — Monorepo Configuration
# =============================================================================
# Duplicate this template as .env for development.
# In production, configure environment variables in your hosting provider (Render, Railway, Vercel).
# NEVER COMMIT SENSITIVE SECRETS OR PASSWORDS TO SOURCE CONTROL.

# -----------------------------------------------------------------------------
# Core Server & Environment
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
API_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Frontend Client & CORS Configuration
# -----------------------------------------------------------------------------
CLIENT_URL=https://app.yourdomain.com
ALLOWED_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com

# -----------------------------------------------------------------------------
# MongoDB Connection (MongoDB Atlas in Production)
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/edumanage_production?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# Security & JWT Tokens (Must be at least 32 characters in production)
# -----------------------------------------------------------------------------
JWT_SECRET=replace_with_cryptographically_secure_random_string_32_chars_min
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_cryptographically_secure_random_refresh_string
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=edumanage-sms-api
JWT_AUDIENCE=edumanage-sms-client
COOKIE_SECRET=replace_with_cryptographically_secure_cookie_secret_32_chars
AUTO_ACTIVATE_SCHOOLS=false

# -----------------------------------------------------------------------------
# Multi-Tenancy Baseline Defaults
# -----------------------------------------------------------------------------
DEFAULT_DEMO_SCHOOL_ID=school_demo_greenwood_001
DEFAULT_DEMO_SCHOOL_NAME="Greenwood International Academy"

# -----------------------------------------------------------------------------
# Email Provider (Nodemailer / Production SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_smtp_api_key_or_password_here
SMTP_FROM_EMAIL=notifications@yourdomain.com
SMTP_FROM_NAME="EduManage School Notifications"

# -----------------------------------------------------------------------------
# Cloud Storage (Cloudinary)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -----------------------------------------------------------------------------
# WebSocket (Socket.IO) Real-Time Configuration
# -----------------------------------------------------------------------------
SOCKET_CORS_ORIGIN=https://app.yourdomain.com
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000

# -----------------------------------------------------------------------------
# AI Assistant & LLM Provider (Google Gemini or OpenAI)
# -----------------------------------------------------------------------------
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=2048

# -----------------------------------------------------------------------------
# Frontend Client Build Variables (Prefixed with VITE_)
# -----------------------------------------------------------------------------
VITE_API_URL=https://api.yourdomain.com/api/v1
VITE_SOCKET_URL=https://api.yourdomain.com
VITE_APP_NAME="EduManage SMS"
VITE_ENABLE_MOCK_AUTH=false
