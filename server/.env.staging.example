# =====================================================================
# EduManage SMS - Staging Environment Configuration (Backend Server)
# =====================================================================
# Pre-production staging template for Node.js Express backend.
# Set these variables in your staging host (e.g. Render/Railway Staging Environment).
# DO NOT COMMIT REAL SECRETS OR PRODUCTION CREDENTIALS.

NODE_ENV=staging
PORT=5000
API_PREFIX=/api/v1

# Staging Frontend Origins & URLs
CLIENT_URL=https://staging-app.edumanage.example.com
ALLOWED_ORIGINS=https://staging-app.edumanage.example.com
SOCKET_CORS_ORIGIN=https://staging-app.edumanage.example.com

# Staging Database (Strictly segregated from production)
MONGODB_URI=mongodb+srv://staging_user:<staging_password>@staging-cluster.mongodb.net/edumanage_staging?retryWrites=true&w=majority

# Cryptographic Secrets (Staging values must be 32+ characters, distinct from production)
JWT_SECRET=staging_jwt_secret_must_be_minimum_32_characters_random_hex
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=staging_jwt_refresh_secret_must_be_at_least_32_chars_long
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=edumanage-sms-api
JWT_AUDIENCE=edumanage-sms-client
COOKIE_SECRET=staging_cookie_secret_must_be_minimum_32_characters_long

# Default Demo Tenant (Staging sandbox)
DEFAULT_DEMO_SCHOOL_ID=school_demo_greenwood_001
DEFAULT_DEMO_SCHOOL_NAME=Greenwood International Academy (Staging)

# Registration & School Activation (Set false in staging to test real OTP email verification)
AUTO_ACTIVATE_SCHOOLS=false

# SMTP Mailer (Test Sink: Mailtrap / Ethereal to prevent sending live emails to students/parents)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=staging_smtp_sandbox_user
SMTP_PASS=staging_smtp_sandbox_pass
SMTP_FROM_EMAIL=staging-notifications@edumanage.example.com
SMTP_FROM_NAME=EduManage SMS (Staging)

# Cloud Storage (Cloudinary staging subfolder or staging cloud)
CLOUDINARY_CLOUD_NAME=staging_cloudinary_cloud
CLOUDINARY_API_KEY=staging_api_key
CLOUDINARY_API_SECRET=staging_api_secret

# AI Assistant (Staging sandbox key or developer tier)
AI_PROVIDER=gemini
AI_API_KEY=staging_ai_sandbox_key
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=15000
AI_MAX_TOKENS=2048
