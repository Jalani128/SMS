PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/edumanage_db
JWT_SECRET=dev_insecure_jwt_secret_change_in_production_minimum_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_insecure_jwt_refresh_secret_change_in_prod_32char
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=edumanage-sms-api
JWT_AUDIENCE=edumanage-sms-client
COOKIE_SECRET=dev_cookie_signing_secret_min_32_chars_long
DEFAULT_DEMO_SCHOOL_ID=school_demo_greenwood_001
DEFAULT_DEMO_SCHOOL_NAME="Greenwood International Academy"
AUTO_ACTIVATE_SCHOOLS=true
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@edumanage.example.com
SMTP_FROM_NAME="EduManage Notifications"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SOCKET_CORS_ORIGIN=http://localhost:5173
AI_PROVIDER=gemini
AI_API_KEY=
