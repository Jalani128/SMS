# EduManage Backend Environment Configuration Template
# Duplicate this file as .env in the server root for local development.
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL.

# -----------------------------------------------------------------------------
# Core Server Configuration
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Client & Cross-Origin Resource Sharing (CORS)
# -----------------------------------------------------------------------------
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Database Configuration (MongoDB)
# -----------------------------------------------------------------------------
# Standard local MongoDB URI or MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/edumanage_db

# -----------------------------------------------------------------------------
# JWT Authentication & Session Architecture
# -----------------------------------------------------------------------------
# Secret keys for signing access and refresh tokens (use cryptographically secure strings in production)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_here
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=edumanage-sms-api
JWT_AUDIENCE=edumanage-sms-client
COOKIE_SECRET=your_cookie_signing_secret_minimum_32_characters_here
AUTO_ACTIVATE_SCHOOLS=true

# -----------------------------------------------------------------------------
# Multi-Tenancy Architecture (Default Demo School)
# -----------------------------------------------------------------------------
DEFAULT_DEMO_SCHOOL_ID=school_demo_greenwood_001
DEFAULT_DEMO_SCHOOL_NAME="Greenwood International Academy"

# -----------------------------------------------------------------------------
# Email Service Architecture (Nodemailer) & Notification Automation (Phase 16)
# -----------------------------------------------------------------------------
# For development, you may use Ethereal (https://ethereal.email) or Mailtrap
# If omitted or invalid, the system runs safely in stub simulation mode without crashing.
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM_EMAIL=no-reply@edumanage.example.com
SMTP_FROM_NAME="EduManage Notifications"
NOTIFICATION_RETRY_LIMIT=3
NOTIFICATION_BATCH_LIMIT=50

# -----------------------------------------------------------------------------
# Media Storage Architecture (Cloudinary)
# -----------------------------------------------------------------------------
# Sign up at https://cloudinary.com to get your cloud credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# -----------------------------------------------------------------------------
# WebSocket (Socket.IO) Architecture
# -----------------------------------------------------------------------------
SOCKET_CORS_ORIGIN=http://localhost:5173
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000

# -----------------------------------------------------------------------------
# AI Assistant & LLM Provider Architecture (Phase 14)
# -----------------------------------------------------------------------------
# Supported AI_PROVIDER values: gemini, openai
AI_PROVIDER=gemini
# Provide your Gemini API key (https://aistudio.google.com) or OpenAI API key (https://platform.openai.com)
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=2048
